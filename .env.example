# Copy to .env and fill in. Never commit .env (CLAUDE.md §25).

NODE_ENV=development

# --- server ---
PORT=4000

# Browser origin allowed to call the API and open a socket.
# 3100 rather than 3000 because 3000 is commonly taken locally.
WEB_ORIGIN=http://localhost:3100

# --- database ---
# Matches docker-compose.yml. The password is local-only and not a secret.
DATABASE_URL=postgres://vo:vo_local_dev_only@localhost:5432/virtual_office

# --- auth ---
# Generate with:  openssl rand -base64 32
# Must be unique per environment. Rotating it invalidates every session.
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:4000

# --- optional: Google sign-in (phase 02) ---
# Leave blank to disable. Email sign-in works without these.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# --- media (phase 08, not needed yet) ---
LIVEKIT_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
